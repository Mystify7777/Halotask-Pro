# Frontend Environment Variables
#
# Every VITE_* value is inlined into the public browser bundle when `vite build` runs. Never put a
# secret, token or credential in a VITE_* variable.

# API Base URL - the public origin of the backend server (scheme, host and optional port only:
# no path, query string, fragment or username/password). Must start with http:// or https://.
#
# Local development: http://localhost:5000
#   (if the variable is unset, `npm run dev` falls back to http://localhost:5000)
# Production: REQUIRED. Example: https://your-api-domain.com
#   There is no fallback: a production build fails (and so does a production bundle at startup) when this
#   is missing or invalid. Vite reads it while building, so on Vercel set it under
#   Project Settings > Environment Variables for the Production scope (and Preview, if previews should
#   talk to an API) BEFORE the build. Changing it later needs a redeploy.
VITE_API_BASE_URL=http://localhost:5000
