PORT=5000
MONGO_URI=
# Resolvers for the one-shot SRV fallback (see docs/context.md "MongoDB Connection"). IPs only.
# Unset/empty/whitespace → defaults; a separator with no entries (",") disables the fallback. The fallback overrides process-wide DNS for one attempt.
MONGO_DNS_SERVERS=8.8.8.8,1.1.1.1
# Server-selection timeout per connection attempt, ms (1000-120000, default 15000).
# MONGO_SERVER_SELECTION_TIMEOUT_MS=15000
JWT_SECRET=
CLIENT_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:5173

# Email Transport (SMTP takes priority if all vars present)
# Primary: SMTP (optional - if all SMTP_* vars set, will be used first)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Secondary: Resend (fallback if SMTP unavailable)
RESEND_API_KEY=
EMAIL_FROM=HaloTaskPro <no-reply@yourdomain.com>

# Password Reset
RESET_TOKEN_TTL_MINUTES=20

# Local/dev only: when no email transport is configured above, setting this
# to "true" logs the reset code to the console so you can test the flow
# without sending real email. Ignored entirely when NODE_ENV=production —
# it cannot be used to leak reset codes in a production deployment.
RESET_CODE_DEMO_MODE=true

# AI task creation (Groq). SERVER-ONLY secret: never expose it via a VITE_* variable.
# Leave empty to disable AI task creation (the endpoint returns 503).
GROQ_API_KEY=

# Rate limiting: number of reverse-proxy hops in front of this server (0 = none; X-Forwarded-For ignored).
#   Local development: 0.   Render: 1.   Railway: unverified - do not guess.
# Never set it higher than the real number of proxies, or callers can choose their own rate-limit bucket.
TRUST_PROXY_HOPS=0
